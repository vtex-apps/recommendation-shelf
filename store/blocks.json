{
  "product-installments#summary": {
    "props": {
      "blockClass": "summary"
    }
  },
  "product-price-savings#summary": {
    "props": {
      "markers": ["discount"],
      "blockClass": "summary"
    }
  },
  "product-selling-price#summary": {
    "props": {
      "blockClass": "summary"
    }
  },
  "flex-layout.row#selling-price-savings": {
    "props": {
      "colGap": 2,
      "preserveLayoutOnMobile": true,
      "preventHorizontalStretch": true,
      "marginBottom": 4
    },
    "children": [
      "product-selling-price#summary",
      "product-price-savings#summary"
    ]
  },
  "product-list-price#summary": {
    "props": {
      "blockClass": "summary"
    }
  },
  "product-summary-image#shelf": {
    "props": {
      "showBadge": false,
      "aspectRatio": "1:1",
      "maxHeight": 300
    }
  },
  "product-summary.shelf": {
    "children": [
      "product-summary-image#shelf",
      "product-summary-name",
      "product-summary-space",
      "product-list-price#summary",
      "flex-layout.row#selling-price-savings",
      "product-installments#summary",
      "add-to-cart-button"
    ]
  },
  "slider-layout#shelf": {
    "props": {
      "itemsPerPage": {
        "desktop": 5,
        "tablet": 3,
        "phone": 1
      },
      "infinite": true,
      "fullWidth": false,
      "blockClass": "shelf"
    }
  },
  "list-context.product-list-static": {
    "blocks": ["product-summary.shelf"],
    "children": ["slider-layout#shelf"]
  },
  "recommendation-shelf": {
    "blocks": ["list-context.product-list-static"]
  },
  "product-summary-image#mini-shelf": {
    "props": {
      "showBadge": false,
      "aspectRatio": "1:1",
      "maxHeight": 72,
      "blockClass": "mini-shelf"
    }
  },
  "product-summary-name#mini-shelf": {
    "props": {
      "blockClass": "mini-shelf"
    }
  },
  "add-to-cart-button#mini-shelf": {
    "props": {
      "blockClass": "mini-shelf",
      "text": "+"
    }
  },
  "flex-layout.col#mini-shelf-info": {
    "props": {
      "width": "grow",
      "rowGap": 1,
      "blockClass": "mini-shelf-info"
    },
    "children": [
      "product-summary-name#mini-shelf",
      "product-selling-price#mini-shelf"
    ]
  },
  "flex-layout.row#mini-shelf-summary": {
    "props": {
      "colGap": 2,
      "preserveLayoutOnMobile": true,
      "verticalAlign": "middle",
      "paddingTop": 2,
      "paddingBottom": 2,
      "blockClass": "mini-shelf",
      "paddingLeft": 1,
      "paddingRight": 1
    },
    "children": [
      "flex-layout.col#mini-shelf-image",
      "flex-layout.col#mini-shelf-info",
      "flex-layout.col#mini-shelf-action"
    ]
  },
  "product-summary.shelf#mini-shelf": {
    "children": ["flex-layout.row#mini-shelf-summary"]
  },
  "slider-layout#mini-shelf": {
    "props": {
      "itemsPerPage": {
        "desktop": 1,
        "tablet": 1,
        "phone": 1
      },
      "centerMode": "to-the-left",
      "centerModeSlidesGap": 8,
      "showNavigationArrows": "always",
      "showPaginationDots": "never",
      "infinite": false,
      "fullWidth": true,
      "navigationStep": 1,
      "blockClass": "mini-shelf",
      "arrowSize": 16
    }
  },
  "list-context.product-list-static#mini-shelf": {
    "blocks": ["product-summary.shelf#mini-shelf"],
    "children": ["slider-layout#mini-shelf"]
  },
  "recommendation-mini-shelf": {
    "blocks": ["list-context.product-list-static#mini-shelf"]
  },
  "product-selling-price#mini-shelf": {
    "props": {
      "blockClass": "mini-shelf"
    }
  },
  "flex-layout.col#mini-shelf-image": {
    "props": {
      "width": "25%",
      "blockClass": "mini-shelf-image",
      "verticalAlign": "middle",
      "horizontalAlign": "center",
      "preventVerticalStretch": true
    },
    "children": ["product-summary-image#mini-shelf"]
  },
  "flex-layout.col#mini-shelf-action": {
    "props": {
      "width": "20%",
      "blockClass": "mini-shelf-action",
      "verticalAlign": "middle",
      "horizontalAlign": "center",
      "preventVerticalStretch": true
    },
    "children": ["add-to-cart-button#mini-shelf"]
  }
}
